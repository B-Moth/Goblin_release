# Release Package .gitignore

# Generated executables (built from source)
*.exe
*.app/
Goblin_*

# Build artifacts
build/
dist/
*.egg-info/
__pycache__/
*.pyc

# Python environment
.venv/
venv/
env/

# IDE and editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# OS-specific files
.DS_Store
Thumbs.db
.Thumbs.db

# Temporary files
*.tmp
*.temp
*.log

# Cache
__pycache__/
.pytest_cache/
.mypy_cache/

# Distribution
*.zip
*.tar.gz
*.tar.bz2
*.rar

# Generated by installer
~/.local/bin/goblin
~/.local/share/applications/goblin*.desktop
~/Applications/Goblin*

# User data (not part of package)
transcriptions/
.APIKEY_*
